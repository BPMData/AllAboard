  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && oxlint --react-plugin -A all -D react/rules-of-hooks -W react/exhaustive-deps src server",
