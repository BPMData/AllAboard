# PORT: HTTP and WebSocket port (defaults to 3000; injected automatically by Cloud Run).
PORT="3000"

# DATA_DIR: Local working directory for the SQLite room store (defaults to ./.data).
# Do NOT set this in production and NEVER point it at a Cloud Storage mount (SQLite needs real file locking).
# On Cloud Run, local disk is wiped on cold start/redeploy; durable backups go to gs://allaboard-data
# automatically via the Cloud Storage API (see docs/DEPLOYMENT.md). No env var or volume is needed.
# DATA_DIR=".data"

# Problem reports (docs/REPORTS.md). Optional: without them, reports fall back to copy/download/email.
# In production deploy.yml sets them from Secret Manager (allaboard-report-relay-url / -token); don't set them by hand.
# REPORT_RELAY_URL="https://script.google.com/macros/s/.../exec"
# REPORT_RELAY_TOKEN=""
